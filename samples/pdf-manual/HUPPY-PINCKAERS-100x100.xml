    <Line X="10" Y="10" X2="90" Y2="10"/>
    <Line X="90" Y="10" X2="90" Y2="90"/>
    <Line X="10" Y="10" X2="10" Y2="90"/>
    <Line X="90" Y="90" X2="10" Y2="90"/>
