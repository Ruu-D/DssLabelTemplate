    <Text X="46" Y="5" FontSize="8" >$EDGE_L1$</Text>
    <Text X="46" Y="92" FontSize="8" >$EDGE_L2$</Text>
    <Text X="5" Y="52" FontSize="8" Rotation="90" >$EDGE_B1$</Text>
    <Text X="92" Y="52" FontSize="8" Rotation="90" >$EDGE_B2$</Text>
  </PrintLabel>
</DSSPrintJob>
