<?xml version="1.0" encoding="UTF-8"?>
<DSSPrintJob Length="$SHEETLENGTH$" Width="$SHEETWIDTH$">
  <PrintLabel ID="$ID$" X="$X$" Y="$Y$" ROTATION="$ROTATION$">
    <Line X="6" Y="6" X2="54" Y2="6"/>
    <Line X="54" Y="6" X2="54" Y2="54"/>
    <Line X="6" Y="6" X2="6" Y2="54"/>
    <Line X="54" Y="54" X2="6" Y2="54"/>
