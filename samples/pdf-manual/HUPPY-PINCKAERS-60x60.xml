    <Text X="28" Y="55" FontSize="5">$EDGE_L2$</Text>
    <Text X="3" Y="31" FontSize="5" Rotation="90">$EDGE_B1$</Text>
    <Text X="55" Y="31" FontSize="5" Rotation="90">$EDGE_B2$</Text>
  </PrintLabel>
</DSSPrintJob>